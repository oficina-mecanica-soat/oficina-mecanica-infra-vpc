# Controla o que a esteira CD Development executa ao entrar na branch develop.
# apply   = cria ou atualiza a VPC da Oficina Mecânica.
# destroy = destrói a VPC da Oficina Mecânica.
# Este arquivo também é usado para disparar a esteira quando a ação operacional muda.
# Disparo controlado após a atualização das credenciais temporárias da AWS Academy.
TERRAFORM_ACTION=destroy
# Preparação de apply com restauração do cache antes da validação de state.
